# ImmoGuinée Rust backend — development environment
# Copy to .env and adjust. In PRODUCTION these secrets come from HashiCorp Vault
# (see specs/001-immog-platform/contracts/secrets.md), NOT from this file.

# --- Server ---
IMMOG_HOST=0.0.0.0
IMMOG_PORT=8000

# --- Database (dev only — prod: Vault secret/immoguinee/db) ---
IMMOG_DATABASE_URL=postgres://immog_user:immog@localhost:5433/immog_db

# --- Redis (dev only — prod: Vault secret/immoguinee/redis) ---
IMMOG_REDIS_URL=redis://:immog_redis_secret@localhost:6379

# --- Vault (prod) — leave empty in dev ---
# IMMOG_VAULT_ADDR=https://vault.immoguinee.internal:8200
# IMMOG_VAULT_APPROLE_ROLE_ID=<role_id>
# secret_id is provided via Docker Secret /run/secrets/vault_approle_secret_id
IMMOG_VAULT_ADDR=
IMMOG_VAULT_APPROLE_ROLE_ID=
IMMOG_JWT_SECRET_VAULT_PATH=secret/immoguinee/app

# --- JWT (dev only — prod: Vault secret/immoguinee/app -> jwt_secret, shared with Laravel) ---
IMMOG_JWT_SECRET=immog-dev-jwt-secret-change-me

# --- CORS / limits ---
IMMOG_CORS_ALLOWED_ORIGIN=*
IMMOG_BODY_LIMIT_BYTES=10485760
IMMOG_REQUEST_TIMEOUT_SECS=60

# --- App env (drives HSTS, etc.) — set to "production" in prod ---
IMMOG_APP_ENV=development

# Tracing
RUST_LOG=immog_backend=info,tower_http=info